<h1>New Recipient</h1>
<%= form_with(model: @recipient) do |recipient| %>
  <%= hidden_field_tag :back, @back %>
  <% unless @event.nil? %>
    <%= hidden_field_tag :event, @event.id %>
  <% end %>
  <p>
  <%= recipient.label :assigned_user_id %>
  <%= recipient.collection_select :assigned_user_id, @friends, :id, :email, prompt: "Select a friend to assign" %>
  </p>
  <p>
    <%= recipient.label :name %><br>
    <%= recipient.text_field :name, required: true%>
  </p>
  <p>
    <%= recipient.label :age%><br>
    <%=recipient.number_field :age, required: true %>
  </p>
  <p>
    <%= recipient.label :occupation%><br>
    <%=recipient.text_field :occupation %>
  </p>
  <p>
    <%= recipient.label :hobbies%><br>
    <%=recipient.text_area :hobbies %>
  </p>
  <p>
    <%= recipient.label :likes%><br>
    <%=recipient.text_area :likes %>
  </p>
  <p>
    <%= recipient.label :dislikes%><br>
    <%=recipient.text_area :dislikes %>
  </p>
  <p>
    <%= recipient.label :budget%><br>
    <%=recipient.number_field :budget %>
  </p>

  <p><%= recipient.submit "Create" %></p>
<% end %>

<p><%= link_to "Back", @back %></p>
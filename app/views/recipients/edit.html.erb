<h1>Edit recipient</h1>
<%= form_with(model: @recipient) do |recipient|  %>
  <%= hidden_field_tag :back, @back %>
  <p>
    <%= recipient.label :assigned_user_id %>
    <%= recipient.collection_select :assigned_user_id, @friends, :id, :email, prompt: "Select a friend to assign" %>
  </p>
  <p>
    <%=recipient.label :name %>
    <%=recipient.text_field :name, required: true %>
  </p>
  <p>
    <%=recipient.label :age %>
    <%=recipient.number_field :age, required: true %>
  </p>
  <p>
    <%=recipient.label :occupation %>
    <%=recipient.text_field :occupation%>
  </p>
  <p>
    <%=recipient.label :hobbies %>
    <%=recipient.text_field :hobbies%>
  </p>
  <p>
    <%=recipient.label :likes %>
    <%=recipient.text_field :likes%>
  </p>
  <p>
    <%=recipient.label :dislikes %>
    <%=recipient.text_field :dislikes%>
  </p>
  <p>
    <%=recipient.label :budget %>
    <%=recipient.text_field :budget%>
  </p>
  <p><%=recipient.submit "submit" %></p>
<% end %>

<%= link_to "Back", recipient_path(@recipient, back:@back)%>
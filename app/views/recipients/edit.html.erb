<h1 class="page-title">Edit Recipient</h1>

<div class="form-card">
  <%= form_with(model: @recipient, local: true) do |recipient| %>
    <%= hidden_field_tag :back, @back %>

    <div class="form-group">
      <%= recipient.label :assigned_user_id, "Assign to Friend" %>
      <%= recipient.collection_select :assigned_user_id,
                                      @friends,
                                      :id,
                                      :email,
                                      { prompt: "Select a friend" } %>
    </div>

    <div class="form-group">
      <%= recipient.label :name %>
      <%= recipient.text_field :name, required: true %>
    </div>

    <div class="form-group">
      <%= recipient.label :age %>
      <%= recipient.number_field :age, required: true %>
    </div>

    <div class="form-group">
      <%= recipient.label :budget %>
      <%= recipient.number_field :budget %>
    </div>

    <div class="form-group">
      <%= recipient.label :occupation %>
      <%= recipient.text_field :occupation %>
    </div>

    <div class="form-group">
      <%= recipient.label :hobbies %>
      <%= recipient.text_area :hobbies, rows: 3 %>
    </div>

    <div class="form-group">
      <%= recipient.label :likes %>
      <%= recipient.text_area :likes, rows: 3 %>
    </div>

    <div class="form-group">
      <%= recipient.label :dislikes %>
      <%= recipient.text_area :dislikes, rows: 3 %>
    </div>

    <div class="form-actions">
      <%= recipient.submit "Update Recipient", class: "btn btn-teal" %>
      <%= link_to "Cancel", recipient_path(@recipient, back: @back), class: "btn btn-dark" %>
    </div>
  <% end %>
</div>

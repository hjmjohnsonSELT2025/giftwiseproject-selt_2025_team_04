<h1 class="page-title">Recipients</h1>

<div class="search-card">
  <%= form_with url: recipients_path, method: :get, local: true do |search| %>
    <div class="search-row">
      <%= search.label :query, "Search recipients" %>
      <%= search.text_field :query, value: params[:query], placeholder: "Enter name..." %>
      <%= search.submit "Search", class: "btn btn-teal" %>

      <% if params[:query].present? %>
        <%= link_to "Clear", recipients_path, class: "btn btn-dark" %>
      <% end %>
    </div>
  <% end %>
</div>

<div class="page-actions">
  <%= link_to "Add New Recipient", new_recipient_path, class: "btn btn-aqua" %>
</div><br>

<% if @recipients.any? %>
  <div class="recipients-grid">
    <% @recipients.each do |recipient| %>
      <div class="recipient-card">
        <div class="recipient-info">
          <h3><%= recipient.name %></h3>
          <p><%= recipient.age %> years old</p>
        </div>

        <div class="recipient-actions">
          <%= link_to "View",
                      recipient_path(recipient),
                      class: "btn btn-teal" %>

          <%= link_to "Edit",
                      edit_recipient_path(recipient),
                      class: "btn btn-dark" %>

          <%= button_to "Delete",
                        recipient_path(recipient),
                        method: :delete,
                        form: { style: "display:inline" },
                        class: "btn btn-danger",
                        confirm: "Are you sure you want to delete #{recipient.name} from your list?" %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="empty-state">You do not have any recipients yet.</p>
<% end %>

<div class="page-actions">
  <%= link_to "← Back", home_index_path, class: "btn btn-dark" %>
</div>

<h1>Recipients</h1>
<%=form_with url: recipients_path, method: :get, local: true do |search| %>
  <%=search.label :query, "Search recipients" %>
  <%=search.text_field :query, value: params[:query] %>
  <%=search.submit "Search" %>

  <% if params[:query].present? %>
    <%= link_to "Clear", recipients_path %>
  <% end %>
<% end %>
<p>
  <%= link_to "Add new Recipient",new_recipient_path %>
</p>
<ul>
  <% @recipients.each do |recipient| %>
    <li>
      <strong> <%=recipient.name %></strong>
      (<%=recipient.age %> years old)
      <%= link_to "Edit",edit_recipient_path(recipient) %>
      <%= button_to "Delete #{recipient.name}", recipient_path(recipient), method: :delete,confirm: "Are you sure you want to delete #{recipient.name} from your list" %>
    </li>
  <% end %>
</ul>
<%= link_to "back", home_index_path %>
<% if @recipients.empty? %>
  <p>You do not have any recipients.</p>
<% end %>
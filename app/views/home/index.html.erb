<h1>Welcome, <%=@username %>.</h1>
<%= button_to "Sign Out", destroy_user_session_path, method: :delete, id: "sign_out" %>
<%= link_to "Profile", user_path %>
<%= link_to "Friends (#{@friends.length})", friends_path %>

<h2>Upcoming Event</h2>
<% if @next_event %>
  <p><strong><%=@next_event.title %></strong></p>
  <p>Date: <%= @next_event.date %></p>
  <p>Location: <%= @next_event.location %></p>
  <p>Theme: <%=@next_event.theme %></p>
  <%= link_to "View Upcoming event", event_path(@next_event) %>
<% else %>
  <p>No upcoming events</p>
<% end %>
<h2>Events</h2>
<p>
  <%= link_to "Add new event", new_event_path(back: home_index_path) %>
  <%= link_to "View all events", events_path %>
</p>

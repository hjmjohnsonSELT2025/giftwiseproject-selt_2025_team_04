<header class="dashboard-header">
  <h1>Welcome, <%= @username %>.</h1>
</header>

<section class="dashboard-section">
  <h2>Upcoming Event</h2>

  <% if @next_event %>
    <div class="container event-card">
      <p class="event-title">
        <strong><%= @next_event.title %></strong>
      </p>

      <p>Date: <%= @next_event.date %></p>

      <% if @next_event.location.present? %>
        <p>Location: <%= @next_event.location %></p>
      <% end %>

      <% if @next_event.theme.present? %>
        <p>Theme: <%= @next_event.theme %></p>
      <% end %>

      <%= link_to "View Upcoming Event",
                  event_path(@next_event),
                  class: "btn btn-teal" %>
    </div>
  <% else %>
    <p class="empty-state">No upcoming events</p>
  <% end %>
</section>

<section class="dashboard-section">
  <h2>Events</h2>

  <div class="dashboard-actions">
    <%= link_to "Add New Event",
                new_event_path(back: home_index_path),
                class: "btn btn-aqua" %>

    <%= link_to "View All Events",
                events_path,
                class: "btn btn-dark" %>
  </div>
</section>

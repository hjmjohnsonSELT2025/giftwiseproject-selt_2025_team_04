<h1>New comment for gift</h1>
<%= form_for @gift_comment do |form| %>
  <div>
    <%= form.hidden_field :user_id, value: current_user.id %>
    <%= form.hidden_field :gift_id, value: params[:return_id] %>
  </div>
  <div>
    <%= form.label :content %>
    <%= form.text_area :content %>
  </div>
  <%= form.submit "Create" %>
<% end %>

<%= link_to "Back", gift_path(params[:return_id]) %>

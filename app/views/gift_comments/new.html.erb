<h1 class="page-title">Add Comment</h1>

<div class="form-card">
  <%= form_for @gift_comment do |form| %>
    <%= form.hidden_field :user_id, value: current_user.id %>
    <%= form.hidden_field :gift_id, value: params[:return_id] %>
    <%= form.hidden_field :back, value: @back %>

    <div class="form-group">
      <%= form.label :content, "Comment" %>
      <%= form.text_area :content, rows: 4, required: true %>
    </div>

    <div class="form-actions">
      <%= form.submit "Post Comment", class: "btn btn-teal" %>
      <%= link_to "Cancel", @back, class: "btn btn-dark" %>
    </div>
  <% end %>
</div>

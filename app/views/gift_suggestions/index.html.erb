<h1>Gift Suggestions</h1>
<%= link_to "Back", @back %>

<p>
  Event: <%= @event.title || "no event selected" %><br>
  Recipient: <%= @recipient&.name || "none selected" %>
</p>
<hr>

<h3>Generate Ideas for <%= @recipient&.name%> </h3>

<%= form_with url: event_gift_suggestions_path(@event, recipient_id: @recipient&.id),
              method: :post do |f| %>

  <%= hidden_field_tag :recipient_id, @recipient.id if @recipient %>
  <%= hidden_field_tag :back, @back %>

  <div>
    <%= f.label :count, "How many suggestions?" %>
    <%= f.number_field :count, value: 1, min: 1, max: 5 %>
  </div>

  <%= f.submit "Generate New Suggestions" %>
<% end %>
<hr>

<h2>Ideas</h2>

<% if @suggestions.present? %>
  <% @suggestions.each do |suggestion| %>
    </li>
      <h3><%= suggestion.title %></h3>
      <p><%= suggestion.description %></p>
      <% if suggestion.estimated_price.present? %>
        <p>Estimated price: $<%= suggestion.estimated_price %></p>
      <% end %>
      <p><small>Source: <%= suggestion.source %></small></p>

      <% existing_gift = current_user.gifts.find_by(gift_suggestion_id: suggestion.id) %>

      <% if existing_gift %>
        <span>Saved as gift</span>
        <%= link_to "View gift", gift_path(existing_gift, back: request.fullpath) %>
      <% else %>
        <%= link_to "Save as a gift",
                    new_gift_path(gift_suggestion_id: suggestion.id,
                                  recipient_id: suggestion.recipient_id,
                                  event_id: suggestion.event_id, back: request.fullpath) %>
      <% end %>
    </li>

  <% end %>
<% else %>
  <p>No suggestions yet.</p>
<% end %>


<h1>Create a new gift</h1>

<%= form_for @new_gift do |form| %>
  <%= form.hidden_field :user_id,  value: current_user.id %>
  <%= hidden_field_tag :back, @back %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>
  <div>
    <%= form.label :description %>
    <%= form.text_field :description %>
  </div>
  <div>
    <%= form.label :recipient_id, "Select recipient" %>
    <%= form.select :recipient_id, options_from_collection_for_select(current_user.recipients, :id, :name, @recipient) %> <!-- replace with recipient ID -->
  </div>
  <div>
    <%= form.label :price %>
    <%= form.number_field :price, step: 0.01 %>
  </div>
  <div>
    <%= form.label :visibility, "Who can see this gift?" %>
    <%= form.select :visibility, GiftsController::VISIBILITY_LIST %>
  </div>
  <%= form.hidden_field :event_id,  value: nil %> <!-- replace with event ID -->
  <%= form.submit "Create" %>
<% end %>

<%= link_to "Back", @back %>

<h1 class="page-title">Create New Gift</h1>

<div class="form-card">
  <%= form_for @new_gift do |form| %>
    <%= form.hidden_field :user_id, value: current_user.id %>
    <%= form.hidden_field :back, value: @back %>
    <%= form.hidden_field :event_id, value: @event.id %>
    <%= form.hidden_field :gift_suggestion_id%>
    <div class="form-group">
      <%= form.label :name %>
      <%= form.text_field :name, required: true %>
    </div>
    <div class="form-group">
      <%= form.label :description %>
      <%= form.text_area :description, rows: 3 %>
    </div>
    <div class="form-group">
      <%= form.label :recipient_id, "Recipient" %>
      <%= form.select :recipient_id,
                      options_from_collection_for_select(@event_recipients, :id, :name, @recipient),
                      { prompt: "Select recipient" } %>
    </div>
    <div class="form-group">
      <%= form.label :price %>
      <%= form.number_field :price, step: 0.01 %>
    </div>
    <div class="form-group">
      <%= form.label :visibility, "Who can see this gift?" %>
      <%= form.select :visibility, Gift::VISIBILITY_LIST %>
    </div>
    <div class="form-group">
      <%= form.label :status, "What's the status of this gift?" %>
      <%= form.select :status, Gift::STATUS_LIST %>
    </div>
    <div class="form-actions">
      <%= form.submit "Create Gift", class: "btn btn-teal" %>
      <%= link_to "Cancel", @back, class: "btn btn-dark" %>
    </div>
  <% end %>
</div>

<% if @backlog.any? %>
  <p><%= "Backlogged ideas for #{current_user.recipients.find(@recipient).name}" %></p>
<% end %>
<div class="gifts-grid">
  <% @backlog.each do |gift| %>
    <div class="gift-card">
      <div class="gift-info">
        <h3><%= gift.name %></h3>
      </div>

      <div class="gift-actions">
        <%= link_to "Use this gift", edit_gift_path(gift, event_id: @event.id), class: "btn btn-teal" %>
      </div>
    </div>
  <% end %>
</div>


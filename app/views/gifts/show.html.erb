<h1><%= "Details about #{@gift.name}" %></h1>
<!--<p><%#= "Recipient: #{@gift.recipient}" %></p>-->
<p><%= "Details: #{@gift.description}" %></p>
<p><%= "Recipient: #{@gift.recipient.name}" %></p>

<!--only show edit and delete buttons if the owner is signed in-->
<% if @gift.user.id == current_user.id %>
  <%= link_to "Edit gift", edit_gift_path(@gift) %>
  <%= button_to 'Delete', gift_path(@gift), method: :delete %>
<% end %>

<%= link_to "Back", home_index_path %>

<h2>Comments</h2>
<% @gift.gift_comments.each do |comment| %>
  <%= "User: #{comment.user.email}" %><br>
  <%= comment.content %><br>
  <% if comment.user_id == current_user.id %>
    <%= button_to "Delete comment", gift_comment_path(comment), method: :delete %>
  <% end %>
<% end %>

<!--include the gift id in the parameters so the user can return here-->
<!--and also so we can link the comment to the gift-->
<%= link_to "Leave a new comment", new_gift_comment_path(return_id: @gift.id) %>
<p>For a monthly subscription of only $7.99 you can edit your comments too!</p>

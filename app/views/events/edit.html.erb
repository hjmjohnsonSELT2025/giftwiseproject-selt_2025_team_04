<h1 class="page-title">Edit Event</h1>

<div class="form-card">
  <%= form_tag event_path(@event.id), method: :patch do %>
    <%= hidden_field_tag :back, @back %>

    <div class="form-group">
      <%= label :event, :title, "Title" %>
      <%= text_field :event, :title, value: @event.title, required: true %>
    </div>

    <div class="form-group">
      <%= label :event, :location, "Location" %>
      <%= text_field :event, :location, value: @event.location %>
    </div>

    <div class="form-group">
      <%= label :event, :theme, "Theme" %>
      <%= text_field :event, :theme, value: @event.theme %>
    </div>

    <div class="form-group">
      <%= label :event, :description, "Description" %>
      <%= text_area :event, :description, rows: 4, value: @event.description %>
    </div>

    <div class="form-row">
      <div class="form-group">
        <%= label :event, :date, "Event Date" %>
        <%= date_select :event, :date, required: true %>
      </div>

      <div class="form-group">
        <%= label :event, :start_time, "Start Time" %>
        <%= time_field :event, :start_time, value: @event.start_time %>
      </div>
    </div>

    <div class="form-actions">
      <%= submit_tag "Update Event", class: "btn btn-teal" %>
      <%= link_to "Cancel", @back, class: "btn btn-dark" %>
    </div>
  <% end %>
</div>

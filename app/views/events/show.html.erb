<h1><%= @event.title %></h1>

<h2>Details about <%= @event.title %></h2>

<ul id="details">
  <li>
    <% if @event.date %>
      Date:
      <%= @event.date.strftime("%B %d, %Y") %>
    <%end %>
  </li>
  <% unless @event.location.empty? %>
    <li>
      Location:
      <%= @event.location %>
    </li>
  <% end %>
  <% unless @event.theme.empty? %>
    <li>
      Theme:
      <%= @event.theme %>
    </li>
  <% end %>

</ul>

<% unless @event.description.empty? %>
  <h3>Description:</h3>
  <p id="description"><%= @event.description %></p>
<% end %>

<section>
  <h2>Recipients</h2>
  <% if @recipients.any? %>
    <ul>
      <% @recipients.each do|recipient| %>
        <h4> <%=recipient.name %> </h4>
          <%= link_to "add a new gift for #{recipient.name}", new_gift_path(event_id: @event.id, recipient_id: recipient.id, back: event_path(@event))%>
          |
          <%= link_to "view recipient", recipient_path(recipient,back: event_path(@event)) %>
          |
        <%= link_to "generate ideas for #{recipient.name}",
                    event_gift_suggestions_path(@event, recipient_id: recipient.id, back: event_path(@event)) %>

          <%= button_to "remove from event", remove_from_event_path(recipient: recipient.id, event: @event.id) %>

        <% if recipient.gifts.any? %>
          <p><%= "Gifts you're buying #{recipient.name}" %></p>
          <ul>
            <% recipient.gifts.where(event_id: @event.id, user_id: current_user.id).each do |gift| %>
              <li><%= link_to gift.name, gift_path(gift, back: event_path(@event)) %></li>
            <% end %>
          </ul>
          <p><%= "Gifts others are buying #{recipient.name}" %></p>
          <ul>
            <% recipient.gifts.where(event_id: @event.id).where.not(user_id: current_user.id).each do |gift| %>
              <% if gift.visibility !=2  %>
                <li><%= "#{gift.user.email} is buying " %> <%= link_to gift.name, gift_path(gift, back: event_path(@event)) %></li>
              <% end %>
            <% end %>
          </ul>
        <%else %>
          <p><em>no gifts yet</em></p>
        <% end %>
      <% end %>
    </ul>
  <% else %>
    <p>No recipients for this event</p>
  <% end %>
  <p>
    <%= form_tag event_add_recipient_path(@event.id), method: :patch do %>
      <%= label :recipient_id, "Add recipients" %>
      <%= select_tag :recipient_id, options_from_collection_for_select(@unadded_recipients, :id, :name), required: true, prompt: "Select a recipient"%>
      <%= submit_tag 'Add' %>
    <% end %>
  </p>
  <p>
    <%= link_to "create a recipient", new_recipient_path(back: event_path(@event), event:@event.id) %>
  </p>
</section>

<h2>People in this event:</h2>
<ul id="details">
  <% @event.users.each { |u| %>
    <li><%=  u.email  %></li>
  <%  } %>
</ul>

<section>
  <h3>Add friend to event</h3>
</section>

<%= form_tag event_invite_path(@event.id), method: :patch do %>
  <%= label :invite_id, "Invite friends" %>
  <%= select_tag :invite_id, options_from_collection_for_select(current_user.friends.where.not(id:@users), :id, :email), required: true, prompt: "Select a friend" %>

  <%= submit_tag 'Invite' %>

<% end %>

<%= form_with(model: @event, method: :patch,) do |f| %>
  <%= f.label :reminders_enabled, "Enable Reminders" %>
  <%= f.check_box :reminders_enabled %>
  <%= f.submit "Update" %>
<% end %>
<br>
<%= link_to 'Edit', edit_event_path(@event, back: event_path(@event)) %>
<%= button_to 'Delete', event_path(@event), method: :delete, confirm: 'Are you sure?' %>
<%= link_to 'Home', home_index_path %>
<%= link_to "All Events", events_path %>



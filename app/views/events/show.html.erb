<h1><%= @event.title %></h1>

<h2>Details about <%= @event.title %></h2>

<ul id="details">
  <li>
    <% if @event.date %>
      Date:
      <%= @event.date.strftime("%B %d, %Y") %>
    <%end %>
  </li>
  <li>
    Location:
    <%= @event.location %>
  </li>
  <li>
    Theme:
    <%= @event.theme %>
  </li>
  <li>
    Recipients:
    <% @event.recipients.each do |recipient| %>
        <br> <%= recipient.name %>
    <% end %>
  </li>
</ul>

<h3>Description:</h3>

<p id="description"><%= @event.description %></p>
<section>
  <h2>Recipients</h2>
  <% if@event.recipients.any? %>
    <ul>
      <% @event.recipients.each do|recipient| %>
        <li>
          <p><strong><%=recipient.name %></strong></p>
          <% if recipient.gifts.any? %>
            <ul>
              <% recipient.gifts.each do |gift| %>
                <li><%= link_to gift.name, gift_path(gift, back: event_path(@event)) %></li>
              <% end %>
            </ul>
          <%else %>
            <p><em>no gifts yet</em></p>
          <% end %>
          <br>
          <%= link_to "add a new gift for #{recipient.name}",new_gift_path(recipient_id: recipient.id,back: event_path(@event)) %>
          |
          <%= link_to "view recipient", recipient_path(recipient,back: event_path(@event)) %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>No recipients for this event</p>
  <% end %>
  <p>
    <%= link_to "create a recipient", new_recipient_path(back: event_path(@event), event:@event.id) %>
  </p>
</section>

<section>
  <h2>Add friend to event</h2>
</section>

<section>
  <h2>Comments</h2>
  <p>comment section</p>
</section>


<h3>People in this event:</h3>

<ul id="details">
  <% for u in @event.users %>
      <li><%= u.email %></li>
  <% end %>
</ul>


<%= form_tag event_invite_path(@event.id), method: :patch do %>

  <%= label :invite_id, "Invite friends" %>
  <%= select_tag :invite_id, options_from_collection_for_select(current_user.friends.where.not(id:@users), :id, :email) %>

  <%= submit_tag 'Invite' %>

<% end %>

<%= form_with(model: @event, method: :patch,) do |f| %>
  <%= f.label :reminders_enabled, "Enable Reminders" %>
  <%= f.check_box :reminders_enabled %>
  <%= f.submit "Update" %>
<% end %>
<br>
<%= link_to 'Edit', edit_event_path(@event) %>
<%= button_to 'Delete', event_path(@event), method: :delete, confirm: 'Are you sure?' %>
<%= link_to 'Home', home_index_path %>
<%= link_to "All Events", events_path %>



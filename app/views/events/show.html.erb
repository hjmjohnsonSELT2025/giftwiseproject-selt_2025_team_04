<h1><%= @event.title %></h1>

<h2>Details about <%= @event.title %></h2>

<ul id="details">
  <li>
    <% if @event.date %>
      Date:
      <%= @event.date.strftime("%B %d, %Y") %>
    <%end %>
  </li>
  <li>
    Location:
    <%= @event.location %>
  </li>
  <li>
    Theme:
    <%= @event.theme %>
  </li>
  <li>
    Recipients:
    <% @event.recipients.each do |recipient| %>
        <br> <%= recipient.name %>
    <% end %>
  </li>
</ul>

<h3>Description:</h3>

<p id="description"><%= @event.description %></p>
<section>
  <h2>Recipients and gifts</h2>
  <% if@event.recipients.any? %>
    <ul>
      <% @event.recipients.each do|recipient| %>
        <li>
          <p><strong><%=recipient.name %></strong></p>
          <% if recipient.gifts.any? %>
            <ul>
              <% recipient.gifts.each do |gift| %>
                <li><%= link_to gift.name, gift_path(gift) %></li>
              <% end %>
            </ul>
          <%else %>
            <p><em>no gifts yet</em></p>
          <% end %>
          <br>
          <%= link_to "add gift for #{recipient.name}",new_gift_path(recipient_id: recipient.id) %>
          <%= link_to "view recipient", recipient_path(recipient) %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>No recipients for this event</p>
  <% end %>
  <p>
    <%= link_to "add a recipient for this event", new_recipient_path(event_id: @event.id) %>
  </p>
</section>

<section>
  <h2>Add friend to event</h2>
</section>

<section>
  <h2>Comments</h2>
  <p>comment section</p>
</section>



<%= link_to 'Edit', edit_event_path(@event) %>
<%= button_to 'Delete', event_path(@event), method: :delete, confirm: 'Are you sure?' %>
<%= link_to 'Back to home', home_index_path %>

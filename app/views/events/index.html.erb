<h1>All events</h1>
<table id="events">
  <thead>
  <tr>
    <th>Title</th>
    <th>Location</th>
    <th>Theme</th>
    <th>Date</th>
    <th>More info</th>
  </tr>
  </thead>
  <tbody>
  <%@events.each do |event| %>
    <tr>
      <td><%= event.title %></td>
      <td><%= event.location %></td>
      <td><%= event.theme %></td>
      <td><%= event.date %></td>
      <td><%= link_to "More about #{event.title}", event_path(event) %></td>
    </tr>
  <% end %>
  </tbody>
</table>
<p>
  <%= link_to "Add new event", new_event_path %>
</p>

<p>
  <%= link_to "Back", home_index_path %>
</p>
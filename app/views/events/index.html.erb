<h1 class="page-title">All Events</h1>


<div class="page-actions">
  <%= link_to "Add New Event", new_event_path(back: events_path), class: "btn btn-aqua" %>
</div><br>

<div class="events-grid">
  <% @events.each do |event| %>
    <div class="event-card">
      <div class="event-header">
        <h2><%= event.title %></h2>
        <span class="event-date"><%= event.date.strftime("%B %d, %Y") rescue event.date %></span>
      </div>

      <div class="event-details">
        <p><strong>Location:</strong> <%= event.location %></p>
        <p><strong>Theme:</strong> <%= event.theme %></p>
      </div>

      <div class="event-actions">
        <%= link_to "View Event", event_path(event), class: "btn btn-teal" %>
      </div>
    </div>
  <% end %>
</div>

<div class="page-actions">
  <%= link_to "Back", home_index_path, class: "btn btn-dark" %>
</div>

<h1><%= @username %></h1>
<%= link_to "Back", friends_path %>

<p>Preferred name:<%= @friend.preferred_name %></p>
<p>Pronouns: <%= @friend.pronouns %></p>
<p>Age: <%= @friend.age %></p>
<p>Job: <%= @friend.job %></p>

<h3>Likes</h3>
<ul>
  <% @friend.likes.each do |like| %>
    <li> <%= like.item %></li>
  <% end %>
</ul>

<h3>Dislikes</h3>
<ul>
  <% @friend.dislikes.each do |like| %>
    <li> <%= like.item %></li>
  <% end %>
</ul>

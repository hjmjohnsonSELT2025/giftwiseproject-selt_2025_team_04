<h1 class="page-title"><%= @username %></h1>

<div class="details-card">
  <div class="details-grid">
    <p><strong>Preferred name:</strong> <%= @friend.preferred_name.presence || "—" %></p>
    <p><strong>Pronouns:</strong> <%= @friend.pronouns.presence || "—" %></p>
    <p><strong>Age:</strong> <%= @friend.age.presence || "—" %></p>
    <p><strong>Job:</strong> <%= @friend.job.presence || "—" %></p>
  </div>
</div>

<h2 class="section-title">Likes</h2>
<% if @friend.likes.any? %>
  <div class="list-card">
    <ul class="clean-list">
      <% @friend.likes.each do |like| %>
        <li><%= like.item %></li>
      <% end %>
    </ul>
  </div>
<% else %>
  <p class="empty-state">No likes listed.</p>
<% end %>

<h2 class="section-title">Dislikes</h2>
<% if @friend.dislikes.any? %>
  <div class="list-card">
    <ul class="clean-list">
      <% @friend.dislikes.each do |like| %>
        <li><%= like.item %></li>
      <% end %>
    </ul>
  </div>
<% else %>
  <p class="empty-state">No dislikes listed.</p>
<% end %>

<div class="page-actions">
  <%= link_to "Back", friends_path, class: "btn btn-dark" %>
</div>

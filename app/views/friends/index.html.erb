<h1 class="page-title">Friends</h1>

<% if @requests.any? %>
  <h2 class="section-title">Friend Requests</h2>

  <div class="friends-grid">
    <% @requests.each do |friend| %>
      <div class="friend-card">
        <p class="friend-name">
          <%= friend.requester.email.split("@").first %>
        </p>

        <div class="friend-actions">
          <%= button_to "Accept",
                        accept_friend_request_path(id: friend.id),
                        method: :post,
                        class: "btn btn-teal" %>

          <%= button_to "Decline",
                        decline_friend_request_path(id: friend.id),
                        method: :post,
                        class: "btn btn-danger" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<h2 class="section-title">Find Friends</h2>

<div class="search-card">
  <%= form_for :search, url: friends_search_path, method: :get do |form| %>
    <div class="search-row">
      <%= form.label :search_term, "Search user by email" %>
      <%= form.text_field :search_term, placeholder: "email@example.com" %>
      <%= form.submit "Search", class: "btn btn-teal" %>
    </div>
  <% end %>
</div>

<% if @results %>
  <div class="friends-grid">
    <% @results.each do |user| %>
      <div class="friend-card">
        <p class="friend-name">
          <%= user.email.split("@").first %>
        </p>

        <div class="friend-actions">
          <% if FriendRequest.exists?(requester: @user, requestee: user) %>
            <span class="muted">Request Sent</span>
          <% else %>
            <%= button_to "Add",
                          create_friend_request_path(id: user.id),
                          method: :post,
                          class: "btn btn-aqua" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<h2 class="section-title">Friend List</h2>

<% if @friends.any? %>
  <div class="friends-grid">
    <% @friends.each do |friend| %>
      <div class="friend-card">
        <p class="friend-name">
          <%= friend.email.split("@").first %>
        </p>

        <div class="friend-actions">
          <%= link_to "View",
                      friend_path(id: friend.id),
                      class: "btn btn-dark" %>

          <%= button_to "Remove",
                        remove_friend_path(id: friend.id),
                        method: :post,
                        class: "btn btn-danger" %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="empty-state">You have no friends.</p>
<% end %>

<div class="page-actions">
  <%= link_to "Back", root_path, class: "btn btn-dark" %>
</div>

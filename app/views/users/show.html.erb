<h1>Profile</h1>
<%= link_to "Home", root_path %>

<p>Preferred name:<%= @user.preferred_name %></p>
<p>Pronouns: <%= @user.pronouns %></p>
<p>Age: <%= @user.age %></p>
<p>Job: <%= @user.job %></p>

<h3>Likes</h3>
  <ul>
    <% @user.likes.each do |like| %>
      <li> <%= like.item %></li>
    <% end %>
  </ul>

<h3>Dislikes</h3>
<ul>
  <% @user.dislikes.each do |like| %>
    <li> <%= like.item %></li>
  <% end %>
</ul>

<%= link_to "Edit", edit_user_path %>
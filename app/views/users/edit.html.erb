<h1 class="page-title">Edit Profile</h1>

<div class="form-card">
  <%= form_for :user, url: user_path, method: :patch do |profile| %>

    <div class="form-group">
      <%= profile.label :preferred_name %>
      <%= profile.text_field :preferred_name, value: @user.preferred_name %>
    </div>

    <div class="form-group">
      <%= profile.label :pronouns %>
      <%= profile.select :pronouns,
                         User::VALID_PRONOUNS,
                         { selected: @user.pronouns } %>
    </div>

    <div class="form-group">
      <%= profile.label :age %>
      <%= profile.number_field :age, in: 0..100, value: @user.age %>
    </div>

    <div class="form-group">
      <%= profile.label :job %>
      <%= profile.text_field :job, value: @user.job %>
    </div>

    <div class="form-group">
      <%= profile.label :likes %>
      <%= profile.text_area :likes, value: @likes, rows: 3 %>
      <p class="form-hint">Comma separated</p>
    </div>

    <div class="form-group">
      <%= profile.label :dislikes %>
      <%= profile.text_area :dislikes, value: @dislikes, rows: 3 %>
      <p class="form-hint">Comma separated</p>
    </div>

    <div class="form-actions">
      <%= profile.submit "Update Profile", class: "btn btn-teal" %>
      <%= link_to "Cancel", user_path, class: "btn btn-dark" %>
    </div>

  <% end %>
</div>
